{
  "name": "olimpiks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:share": "VITE_SHARE=1 vite build --outDir dist-share --emptyOutDir && rm -rf dist-share/pdfjs dist-share/fonts && node scripts/share-clean.mjs",
    "build": "tsc -b && vite build",
    "build:server": "VITE_AUTH=1 vite build",
    "build:pages": "VITE_STATIC=1 vite build --outDir dist-pages --emptyOutDir && rm -rf dist-pages/fonts dist-pages/pdfjs && node scripts/share-clean.mjs dist-pages",
    "server": "node --env-file=server/.env server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:content": "esbuild src/content/validate.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/validate.cjs && node node_modules/.cache/validate.cjs",
    "konspekt": "node scripts/convert-konspekt.mjs",
    "postinstall": "node scripts/copy-pdf-assets.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-pdf": "9.2.1",
    "react-router-dom": "6.28.0",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
